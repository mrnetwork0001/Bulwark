# Copy to .env and fill in. Never commit .env. Bulwark loads .env automatically.

# neatlogs: traces for every experiment, trial and agent step (neatlogs.com → project → API key)
NEATLOGS_API_KEY=

# LLM, pick one (Anthropic direct wins if both are set):
# 0G Compute Router: Claude models billed in 0G tokens (pc.0g.ai → deposit 0G → create API key)
ZG_ROUTER_API_KEY=
ZG_ROUTER_BASE_URL=https://router-api.0g.ai
# Anthropic direct (console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional model overrides (blank = provider default)
BULWARK_MODEL=
REFUNDBOT_MODEL=
RESEARCHBOT_MODEL=
PORT=5317

# Cost tracking: assumed USD/hour of the machine running Bulwark (default 0.10)
BULWARK_COMPUTE_USD_PER_HOUR=

# Crustdata: company & people data for the ResearchBot demo agent and market sizing (crustdata.com)
CRUSTDATA_API_KEY=

# Run-done notifications (bulwark/notify.ts): a finished `npm run fix` / dashboard loop posts a summary
# when either webhook is set (https:// only). `npm run fix -- --dry-run-notify` prints the payloads instead.
BULWARK_SLACK_WEBHOOK_URL=
BULWARK_DISCORD_WEBHOOK_URL=
# Optional link in the notification: the run id is appended (".../runs/<id>/", or after a trailing "=")
# e.g. http://localhost:5317/api/artifact?file=PR.md&run=
BULWARK_ARTIFACTS_BASE_URL=
