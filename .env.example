# Copy to .env and fill in. Never commit .env.

# Bulwark reasoning model
ANTHROPIC_API_KEY=

# neatlogs tracing
NEATLOGS_API_KEY=

# AWS (Bedrock fallback model for RefundBot; credits from web check-in)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Dodo Payments (test mode only)
DODO_PAYMENTS_API_KEY=

# GitHub (for opening PRs)
GITHUB_TOKEN=

# Safety rails
BULWARK_MAX_BUDGET_USD=5
BULWARK_TRIALS_PER_FAULT=20
BULWARK_MAX_FIX_ATTEMPTS=3
