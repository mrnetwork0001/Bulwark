# Copy to .env and fill in. Never commit .env. Bulwark loads .env automatically.

# neatlogs: traces for every experiment, trial and agent step (neatlogs.com → project → API key)
NEATLOGS_API_KEY=

# Anthropic: Claude writes Blue's fixes; also `npm run chaos -- --brain claude` (console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional
BULWARK_MODEL=claude-sonnet-5-5
REFUNDBOT_MODEL=claude-haiku-5-5
PORT=5317
