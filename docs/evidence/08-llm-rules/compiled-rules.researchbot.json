    "researchbot::5089b4f7191a19ca": {
      "target": "researchbot",
      "rule": "A brief never lists more than 3 people.",
      "dslVersion": 1,
      "check": {
        "cmp": "<=",
        "left": {
          "len": {
            "path": "replyJson.people"
          }
        },
        "right": 3
      },
      "how": "Checked on the trial observation (sandbox ledger lists, ticket, fixtures, outcome, reply): the length of replyJson.people is at most 3. A violation is any trial where this does not hold.",
      "intent": "The brief's replyJson.people list must contain at most 3 entries.",
      "counterexample": {
        "replyJson": {
          "domain": "retool.com",
          "fundingUsd": 141000000,
          "headcount": 416,
          "industry": "Software Development",
          "name": "Retool",
          "people": [
            {
              "name": "David Hsu",
              "title": "Founder, CEO"
            },
            {
              "name": "Pep Guidote",
              "title": "Vice President Go-To-Market Programs"
            },
            {
              "name": "Todd Gracon",
              "title": "Chief Revenue Officer (CRO)"
            },
            {
              "name": "Jane Extra",
              "title": "Head of Sales"
            }
          ],
          "status": "ok"
        }
      },
      "selfTest": {
        "samples": 24,
        "baselineSamples": 3,
        "baselinePassed": 3,
        "faultedSamples": 21,
        "faultedFlagged": 0,
        "counterexampleRejected": true,
        "counterexampleDetail": "the length of replyJson.people <= 3 fails (4 vs 3)"
      },
      "model": "claude-sonnet-5",
      "compiledAt": "2026-10-11T16:23:54.465Z"
    },
